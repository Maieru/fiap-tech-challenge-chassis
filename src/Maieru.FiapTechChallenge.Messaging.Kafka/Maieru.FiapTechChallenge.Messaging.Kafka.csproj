<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <Authors>João Victor Maieru Teixeira</Authors>
    <Description>Kafka publisher for the FIAP Tech Challenge messaging interface.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Maieru/fiap-tech-challenge-chassis</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Maieru.FiapTechChallenge.Chassis" Version="$(ChassisVersion)" />
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
